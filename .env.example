# Local Supabase (from `supabase status`). Copy this file to `.env.local` and fill values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Branding
MONOGRAM_LETTERS=1

# App
APP_URL=http://127.0.0.1:3000

# Google OAuth — Supabase-side (NOT app runtime). Needed only to exercise Google locally.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI prose + report (M5b / plan 3) — server only. OPENAI_API_KEY set ⇒ AI is ON (the model writes
# the report; the diagnosis page auto-generates it on admin view). Key unset ⇒ deterministic
# fallback templates, no API call, one `[prose-mode]` warn line per process saying why.
# PROSE_MODE is an OPTIONAL override: PROSE_MODE=fallback forces AI off even with a key;
# PROSE_MODE=ai forces it on (a missing key then just fails over per section, with a warn).
# OPENAI_API_KEY=
# OPENAI_MODEL_PROSE=gpt-5.1
# PROSE_MODE=                      # (unset) key decides | ai | fallback

# Email (member invitations, via Resend). Without these the invite is still created and the
# admin gets a copyable link; these only enable automatic email delivery.
#   RESEND_API_KEY — from resend.com (set in Vercel Production too; Vercel env is separate from this file).
#   EMAIL_FROM     — an address on a domain you verified at resend.com/domains, e.g.
#                    invites@360churchhealthassessment.com. If unset, sends fall back to Resend's
#                    onboarding@resend.dev test address, which ONLY delivers to the Resend account owner.
# RESEND_API_KEY=
# EMAIL_FROM=invites@360churchhealthassessment.com
#   INVITE_FROM / REMINDER_FROM — optional per-type senders (both on a verified domain). Each falls
#   back to EMAIL_FROM, then to onboarding@resend.dev. Set them to send invitations and reminders
#   from distinct addresses, e.g. welcome@… and reminders@…; leave unset to use EMAIL_FROM for both.
# INVITE_FROM=welcome@360churchhealthassessment.com
# REMINDER_FROM=reminders@360churchhealthassessment.com

# Intentionally omitted until their milestone: SUPABASE_SERVICE_ROLE_KEY, OPENAI_MODEL_CLASSIFY
