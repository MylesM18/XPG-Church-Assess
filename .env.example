# Local Supabase (from `supabase status`). Copy this file to `.env.local` and fill values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Branding
MONOGRAM_LETTERS=1

# App
APP_URL=http://127.0.0.1:3000

# Google OAuth — Supabase-side (NOT app runtime). Needed only to exercise Google locally.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI prose (M5b) — server only. Unset PROSE_MODE ⇒ fallback: no API call, deterministic templates.
# Set PROSE_MODE=ai (and provide a key) to turn AI rewording + display on together.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_PROSE=claude-sonnet-5
# PROSE_MODE=fallback              # ai | fallback

# Intentionally omitted until their milestone: SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_MODEL_CLASSIFY, RESEND_*, EMAIL_FROM
